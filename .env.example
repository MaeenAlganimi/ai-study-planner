# Copy to .env in the repository root. Leave GEMINI_API_KEY empty to run in demo mode.

# Server
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# auto uses Gemini when GEMINI_API_KEY is set, otherwise the deterministic mock provider.
LLM_PROVIDER=auto
PORT=8787
# Comma-separated browser origins allowed to call the API. Required for a split deploy.
# Leave unset when the API and the web app share an origin.
CLIENT_ORIGIN=http://localhost:5173
MAX_UPLOAD_BYTES=5242880

# Web (apps/web/.env.local). Leave empty in development; Vite proxies /api to the server.
# Set this to the public API origin for a split Vercel deploy.
VITE_API_URL=
